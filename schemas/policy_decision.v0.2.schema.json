{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyDecision v0.2",
  "type": "object",
  "required": ["artifact_type", "schema_version", "schema_ref", "decision_id", "created_at", "decision", "links", "scope", "capability", "risk", "constraints"],
  "properties": {
    "artifact_type": {"const": "policy_decision"},
    "schema_version": {"const": "v0.2"},
    "schema_ref": {"const": "schemas/policy_decision.v0.2.schema.json"},
    "decision_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allow_prepare", "owner_approval_required", "deny"]},
    "links": {"type": "object"},
    "scope": {"type": "object"},
    "capability": {"type": "object"},
    "risk": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
