{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sclite.local/schemas/scope_fidelity_report.v0.1.schema.json",
  "title": "Security Contract Layer ScopeFidelityReport v0.1",
  "description": "Static, public-safe host-binding review artifact for comparing a target host against hosts detected in normalized arguments and execution-plan steps. This is not live target execution and does not prove authorization.",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "schema_ref",
    "generated_at",
    "target",
    "target_host",
    "target_in_scope",
    "source_artifact",
    "verdict",
    "request_shape",
    "public_safety",
    "limitations"
  ],
  "properties": {
    "artifact_type": {
      "const": "scope_fidelity_report"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "schema_ref": {
      "const": "schemas/scope_fidelity_report.v0.1.schema.json"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string"
    },
    "target_host": {
      "type": "string"
    },
    "target_in_scope": {
      "type": ["boolean", "null"]
    },
    "source_artifact": {
      "type": "string"
    },
    "verdict": {
      "enum": ["pass", "review", "fail"]
    },
    "request_shape": {
      "type": "object",
      "required": [
        "arg_hosts_detected",
        "execution_plan_hosts_detected",
        "all_hosts_detected",
        "mismatched_hosts_detected",
        "target_host_match_status",
        "request_shape_hygiene_status",
        "request_shape_hygiene_reason",
        "request_shape_hygiene_source"
      ],
      "properties": {
        "arg_hosts_detected": {
          "type": "array",
          "items": {"type": "string"}
        },
        "execution_plan_hosts_detected": {
          "type": "array",
          "items": {"type": "string"}
        },
        "all_hosts_detected": {
          "type": "array",
          "items": {"type": "string"}
        },
        "mismatched_hosts_detected": {
          "type": "array",
          "items": {"type": "string"}
        },
        "target_host_match_status": {
          "enum": ["exact", "mixed", "none_detected"]
        },
        "request_shape_hygiene_status": {
          "enum": ["clean", "ambiguous", "cross_host_mismatch"]
        },
        "request_shape_hygiene_reason": {
          "type": "string"
        },
        "request_shape_hygiene_source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "public_safety": {
      "type": "object",
      "required": ["live_target_execution", "protocol_adapter_work", "public_push", "static_analysis_only"],
      "properties": {
        "live_target_execution": {"const": false},
        "protocol_adapter_work": {"const": false},
        "public_push": {"const": false},
        "static_analysis_only": {"const": true}
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
