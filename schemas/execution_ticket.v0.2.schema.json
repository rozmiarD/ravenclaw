{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionTicket v0.2",
  "type": "object",
  "required": ["artifact_type", "schema_version", "schema_ref", "ticket_id", "created_at", "links", "approval", "validity", "execution_limits", "integrity"],
  "properties": {
    "artifact_type": {"const": "execution_ticket"},
    "schema_version": {"const": "v0.2"},
    "schema_ref": {"const": "schemas/execution_ticket.v0.2.schema.json"},
    "ticket_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "links": {"type": "object"},
    "approval": {"type": "object"},
    "validity": {"type": "object"},
    "execution_limits": {"type": "object"},
    "integrity": {"type": "object"},
    "signature": {"type": "object"},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
