{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntentContract v0.2",
  "type": "object",
  "required": ["artifact_type", "schema_version", "schema_ref", "intent_id", "created_at", "actor", "intent", "requested_capability", "target", "authority"],
  "properties": {
    "artifact_type": {"const": "intent_contract"},
    "schema_version": {"const": "v0.2"},
    "schema_ref": {"const": "schemas/intent_contract.v0.2.schema.json"},
    "intent_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "actor": {"type": "object"},
    "intent": {"type": "object"},
    "requested_capability": {"type": "object"},
    "target": {"type": "object"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "object"},
    "non_claims": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
