{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sclite.local/schemas/redaction_policy.v0.1.schema.json",
  "title": "SCLite RedactionPolicy v0.1",
  "description": "Draft public-safe redaction policy descriptor. It documents redaction intent and constraints; it is not a complete secret scanner or publication authorization.",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "policy_id",
    "mode",
    "rules",
    "public_safety",
    "non_claims"
  ],
  "properties": {
    "artifact_type": {
      "const": "redaction_policy"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "description",
          "applies_to",
          "action",
          "replacement"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "replacement": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "public_safety": {
      "type": "object",
      "required": [
        "live_target_execution",
        "raw_live_evidence_included",
        "raw_stdout_stderr_included",
        "credentials_included",
        "private_paths_included"
      ],
      "properties": {
        "live_target_execution": {
          "const": false
        },
        "raw_live_evidence_included": {
          "const": false
        },
        "raw_stdout_stderr_included": {
          "const": false
        },
        "credentials_included": {
          "const": false
        },
        "private_paths_included": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
