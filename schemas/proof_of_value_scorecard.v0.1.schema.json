{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ravenclaw.local/schemas/proof_of_value_scorecard.v0.1.schema.json",
  "title": "Ravenclaw ProofOfValueScorecard v0.1",
  "description": "Public-safe scorecard for Ravenclaw proof-of-value benchmark dimensions. This is a local review artifact and does not claim live vulnerability discovery, production readiness, or protocol-adapter completeness.",
  "type": "object",
  "required": ["artifact_type", "schema_version", "schema_ref", "summary", "scope", "dimensions"],
  "properties": {
    "artifact_type": {"const": "proof_of_value_scorecard"},
    "schema_version": {"const": "v0.1"},
    "schema_ref": {"const": "schemas/proof_of_value_scorecard.v0.1.schema.json"},
    "summary": {
      "type": "object",
      "required": ["dimension_count", "passed", "failed", "status"],
      "properties": {
        "dimension_count": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "status": {"enum": ["passed", "failed"]}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["public_safe", "dry_run_or_local_only", "live_target_execution", "protocol_adapter_work", "live_vulnerability_claim"],
      "properties": {
        "public_safe": {"const": true},
        "dry_run_or_local_only": {"const": true},
        "live_target_execution": {"const": false},
        "protocol_adapter_work": {"const": false},
        "live_vulnerability_claim": {"const": false}
      },
      "additionalProperties": false
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "evidence_paths", "claim", "non_claim"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "present"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "present": {"type": "boolean"}
              },
              "additionalProperties": false
            }
          },
          "claim": {"type": "string", "minLength": 1},
          "non_claim": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
