{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactChainManifest v0.2",
  "type": "object",
  "required": ["artifact_type", "schema_version", "schema_ref", "chain_id", "created_at", "profile", "canonicalization", "hash_algorithm", "signature_policy", "entries", "root_chain_digest"],
  "properties": {
    "artifact_type": {"const": "artifact_chain_manifest"},
    "schema_version": {"const": "v0.2"},
    "schema_ref": {"const": "schemas/artifact_chain_manifest.v0.2.schema.json"},
    "chain_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "canonicalization": {"const": "sclite-artifact-chain-v0.2"},
    "hash_algorithm": {"const": "sha256"},
    "signature_policy": {"type": "object"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "path", "required", "descriptor", "previous_chain_digest", "chain_digest"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "descriptor": {"type": "object"},
          "previous_chain_digest": {"type": "string"},
          "chain_digest": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "root_chain_digest": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
