{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sclite.local/schemas/prepared_execution_spec.v0.1.schema.json",
  "title": "SCLite PreparedExecutionSpec v0.1",
  "description": "Draft v0.1 neutral prepared execution shape. Validates the concrete tool/action contract prepared before approval; it does not authorize or execute the action.",
  "type": "object",
  "required": [
    "artifact_type",
    "spec_version",
    "target",
    "target_host",
    "target_in_scope",
    "resolved_tool",
    "normalized_args",
    "execution_plan",
    "scope_facts"
  ],
  "properties": {
    "artifact_type": {
      "const": "prepared_execution_spec"
    },
    "spec_version": {
      "const": "2026-03-18.prepared.v1"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "target_host": {
      "type": "string",
      "minLength": 1
    },
    "target_in_scope": {
      "type": "boolean"
    },
    "action_type": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "task_family": {
      "type": "string"
    },
    "execution_mode": {
      "type": "string"
    },
    "resolved_planner_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_tool": {
      "type": "string",
      "minLength": 1
    },
    "tool_candidates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalized_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stdin": {
      "type": "string"
    },
    "execution_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "args"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stdin": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "arg_hosts_detected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution_plan_hosts_detected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "all_hosts_detected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mismatched_hosts_detected": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_host_match_status": {
      "type": "string"
    },
    "request_shape_hygiene_status": {
      "type": "string"
    },
    "request_shape_hygiene_reason": {
      "type": "string"
    },
    "request_shape_hygiene_source": {
      "type": "string"
    },
    "scope_facts": {
      "type": "object",
      "required": [
        "target",
        "target_host",
        "target_in_scope"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "target_host": {
          "type": "string",
          "minLength": 1
        },
        "target_in_scope": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "command_preview": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command_input_summary": {
      "type": "object"
    },
    "execution_input_summaries": {
      "type": "array"
    },
    "prepared_by": {
      "type": "string"
    },
    "preparation_source": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
