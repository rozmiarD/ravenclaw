{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sclite.local/schemas/public_snapshot_manifest.v0.1.schema.json",
  "title": "SCLite PublicSnapshotManifest v0.1",
  "description": "Draft public snapshot manifest for selected public-safe artifacts. It can include canonical hash descriptors but does not prove provenance or authorize publication.",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "snapshot_name",
    "snapshot_version",
    "generated_at",
    "files",
    "summary",
    "public_safety",
    "non_claims"
  ],
  "properties": {
    "artifact_type": {
      "const": "public_snapshot_manifest"
    },
    "schema_version": {
      "const": "v0.1"
    },
    "snapshot_name": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "artifact_type",
          "schema",
          "public_safe"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "artifact_type": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "public_safe": {
            "type": "boolean"
          },
          "hash": {
            "type": "object",
            "required": [
              "canonicalization",
              "algorithm",
              "digest",
              "canonical_bytes"
            ],
            "properties": {
              "canonicalization": {
                "const": "sclite-json-v0.1"
              },
              "algorithm": {
                "const": "sha256"
              },
              "digest": {
                "type": "string",
                "minLength": 1
              },
              "canonical_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "file_count",
        "hashed_file_count",
        "public_safe_file_count"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "hashed_file_count": {
          "type": "integer",
          "minimum": 0
        },
        "public_safe_file_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "public_safety": {
      "type": "object",
      "required": [
        "live_target_execution",
        "protocol_adapter_work",
        "raw_live_evidence_included",
        "raw_stdout_stderr_included"
      ],
      "properties": {
        "live_target_execution": {
          "const": false
        },
        "protocol_adapter_work": {
          "const": false
        },
        "raw_live_evidence_included": {
          "const": false
        },
        "raw_stdout_stderr_included": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "non_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
