{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustProfileRef v0.1",
  "type": "object",
  "required": [
    "artifact_type",
    "schema_version",
    "schema_ref",
    "profile_ref_id",
    "created_at",
    "trust_profile",
    "links",
    "reference",
    "integrity",
    "verification_boundary",
    "non_claims"
  ],
  "properties": {
    "artifact_type": {"const": "trust_profile_ref"},
    "schema_version": {"const": "v0.1"},
    "schema_ref": {"const": "schemas/trust_profile_ref.v0.1.schema.json"},
    "profile_ref_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "trust_profile": {
      "type": "string",
      "enum": ["none", "digest_only", "local_ed25519_ref", "dsse_envelope_ref", "sigstore_bundle_ref", "external_verifier"]
    },
    "links": {
      "type": "object",
      "required": ["subject"],
      "properties": {
        "subject": {"$ref": "#/$defs/artifact_link"}
      },
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "uri": {"type": "string"},
        "digest": {"type": "string"},
        "verifier": {"type": "string"}
      },
      "additionalProperties": true
    },
    "integrity": {
      "type": "object",
      "required": ["subject_artifact_digest", "binding_mode"],
      "properties": {
        "subject_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binding_mode": {"const": "subject_descriptor_digest"}
      },
      "additionalProperties": true
    },
    "verification_boundary": {
      "type": "object",
      "required": ["sclite_validates_digest_binding_only", "external_verifier_decides_trust"],
      "properties": {
        "sclite_validates_digest_binding_only": {"const": true},
        "external_verifier_decides_trust": {"const": true}
      },
      "additionalProperties": true
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "artifact_link": {
      "type": "object",
      "required": ["role", "descriptor"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "descriptor": {"$ref": "#/$defs/descriptor"}
      },
      "additionalProperties": true
    },
    "descriptor": {
      "type": "object",
      "required": ["artifact_type", "schema_version", "schema_ref", "canonicalization", "algorithm", "digest", "canonical_bytes"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "schema_ref": {"type": "string", "minLength": 1},
        "canonicalization": {"type": "string", "minLength": 1},
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
