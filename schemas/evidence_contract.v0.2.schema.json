{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceContract v0.2",
  "type": "object",
  "required": ["artifact_type", "schema_version", "schema_ref", "evidence_contract_id", "created_at", "links", "claims", "non_claims", "replay", "verification"],
  "properties": {
    "artifact_type": {"const": "evidence_contract"},
    "schema_version": {"const": "v0.2"},
    "schema_ref": {"const": "schemas/evidence_contract.v0.2.schema.json"},
    "evidence_contract_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "links": {
      "type": "object",
      "required": ["execution_receipt"],
      "properties": {
        "execution_receipt": {"$ref": "#/$defs/artifact_link"},
        "execution_ticket": {"$ref": "#/$defs/artifact_link"}
      },
      "additionalProperties": true
    },
    "claims": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "replay": {
      "type": "object",
      "required": ["mode", "live_execution_required"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "live_execution_required": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "artifact_link": {
      "type": "object",
      "required": ["role", "descriptor"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "descriptor": {"$ref": "#/$defs/descriptor"}
      },
      "additionalProperties": true
    },
    "descriptor": {
      "type": "object",
      "required": ["artifact_type", "schema_version", "schema_ref", "canonicalization", "algorithm", "digest", "canonical_bytes"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "schema_ref": {"type": "string", "minLength": 1},
        "canonicalization": {"type": "string", "minLength": 1},
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
